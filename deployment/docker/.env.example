# Copy this file to deployment/docker/.env and replace every required placeholder.
# Never commit the resulting .env file.

SQL_SA_PASSWORD=replace-with-a-long-random-sql-password
LODESTONE_ADMIN_PASSWORD=replace-with-a-long-random-admin-password
LODESTONE_ADMIN_EMAIL=admin@example.invalid

# ML remains disabled until a real artifact passes all fixed quality gates.
LODESTONE_ML_ENABLED=false
LODESTONE_USE_HANGFIRE=true
LODESTONE_PUBLIC_BASE_URL=https://localhost:5001

# Optional SMTP settings. Leave credentials empty if email is not being exercised.
LODESTONE_SMTP_HOST=smtp.example.invalid
LODESTONE_SMTP_PORT=587
LODESTONE_EMAIL_FROM=no-reply@example.invalid
LODESTONE_SMTP_USERNAME=
LODESTONE_SMTP_PASSWORD=
