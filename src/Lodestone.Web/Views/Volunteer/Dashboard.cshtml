@using Lodestone.Application.DTOs.Volunteer
@using Lodestone.Domain.Enums
@model Lodestone.Web.ViewModels.Volunteer.VolunteerDashboardViewModel
@{
    ViewData["Title"] = "Volunteer Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/peer-support.css" asp-append-version="true" />
}

<div class="container my-5" data-peer-support-live>
    <span class="visually-hidden-status" role="status" aria-live="polite" data-peer-support-status></span>

    <div class="row mb-4">
        <div class="col-12">
            <h1>Volunteer Dashboard</h1>
            <p class="text-muted">Manage peer support requests and help students in your community.</p>
        </div>
    </div>

    @if (TempData["SupportSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SupportSuccess"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["SupportError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["SupportError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Dashboard.CanHandleRequests)
    {
        <div class="alert alert-warning" role="alert">
            @(Model.Dashboard.AccessMessage ?? "You are not currently eligible to handle peer support requests.")
        </div>
    }
    else
    {
        @if (Model.Dashboard.Profile is { } profile)
        {
            <div class="card mb-4 @(profile.IsAway ? "border-warning" : "")">
                <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div>
                        <h5 class="card-title mb-1">
                            <i class="bi @(profile.IsAway ? "bi-moon" : "bi-check-circle")"></i>
                            @(profile.IsAway ? "You are away" : "You are available")
                        </h5>
                        <p class="card-text text-muted mb-0">
                            @if (profile.IsAway)
                            {
                                <text>Not suggested for new requests until <strong>@profile.AwayUntilUtc?.ToLocalTime().ToString("MMM d, yyyy")</strong>. Existing conversations stay open.</text>
                                @if (!string.IsNullOrWhiteSpace(profile.AwayMessage))
                                {
                                    <br /><em>"@profile.AwayMessage"</em>
                                }
                            }
                            else
                            {
                                <text>Administrators can route new requests to you. Mark yourself away during exams or breaks.</text>
                            }
                        </p>
                    </div>
                    @if (profile.IsAway)
                    {
                        <form method="post" asp-controller="Volunteer" asp-action="SetAvailability">
                            <input type="hidden" name="isAway" value="false" />
                            <button type="submit" class="btn btn-outline-success">I'm back</button>
                        </form>
                    }
                    else
                    {
                        <form method="post" asp-controller="Volunteer" asp-action="SetAvailability" class="d-flex flex-wrap align-items-end gap-2">
                            <input type="hidden" name="isAway" value="true" />
                            <div>
                                <label for="awayUntil" class="form-label small mb-0">Away until</label>
                                <input type="date" id="awayUntil" name="awayUntil" class="form-control form-control-sm"
                                       min="@DateTime.UtcNow.AddDays(1).ToString("yyyy-MM-dd")" max="@DateTime.UtcNow.AddDays(90).ToString("yyyy-MM-dd")"
                                       value="@DateTime.UtcNow.AddDays(7).ToString("yyyy-MM-dd")" />
                            </div>
                            <div>
                                <label for="awayMessage" class="form-label small mb-0">Note (optional)</label>
                                <input type="text" id="awayMessage" name="awayMessage" maxlength="200" class="form-control form-control-sm" placeholder="e.g. Exams this week" />
                            </div>
                            <button type="submit" class="btn btn-outline-secondary btn-sm">Mark me away</button>
                        </form>
                    }
                </div>
            </div>
        }

        <div class="row mb-4">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Pending Requests</h5>
                        <p class="card-text display-4">@Model.Dashboard.PendingRequests.Count</p>
                        <p class="card-text text-muted">Requests awaiting your response</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Active Support</h5>
                        <p class="card-text display-4">@Model.Dashboard.ActiveRequests.Count</p>
                        <p class="card-text text-muted">Requests you're currently helping with</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-8">
                @if (Model.Dashboard.PendingRequests.Count > 0)
                {
                    <div class="card mb-4">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">Pending Requests</h5>
                        </div>
                        <div class="card-body">
                            <div class="list-group">
                                @foreach (var request in Model.Dashboard.PendingRequests)
                                {
                                    <div class="list-group-item">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div class="flex-grow-1">
                                                <h6 class="mb-1">@request.Title</h6>
                                                <p class="mb-1 text-muted">
                                                    <span class="badge bg-secondary">@request.Category</span>
                                                </p>
                                                <small class="text-muted">Posted @request.CreatedAtUtc.ToString("MMM d, yyyy")</small>
                                            </div>
                                            <a href="@Url.Action("ViewRequest", "Volunteer", new { requestId = request.Id })" class="btn btn-sm btn-primary">
                                                View Request
                                            </a>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-info mb-4">
                        <i class="bi bi-info-circle"></i>
                        No pending requests at this time. Check back soon!
                    </div>
                }

                @if (Model.Dashboard.ActiveRequests.Count > 0)
                {
                    <div class="card mb-4">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">Active Support</h5>
                        </div>
                        <div class="card-body">
                            <div class="list-group">
                                @foreach (var request in Model.Dashboard.ActiveRequests)
                                {
                                    <div class="list-group-item">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div class="flex-grow-1">
                                                <h6 class="mb-1">@request.Title</h6>
                                                <p class="mb-1 text-muted">
                                                    <span class="badge bg-success">Accepted</span>
                                                    <span class="badge bg-secondary">@request.Category</span>
                                                    @if (request.UnreadForVolunteer > 0)
                                                    {
                                                        <span class="badge bg-danger">@request.UnreadForVolunteer new</span>
                                                    }
                                                </p>
                                                <small class="text-muted">Started @request.CreatedAtUtc.ToString("MMM d, yyyy")</small>
                                            </div>
                                            <a href="@Url.Action("ViewRequest", "Volunteer", new { requestId = request.Id })" class="btn btn-sm btn-primary">
                                                Continue
                                            </a>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                @if (Model.Dashboard.History.Count > 0)
                {
                    <div class="card mb-4">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">History</h5>
                        </div>
                        <div class="card-body">
                            <div class="list-group">
                                @foreach (var request in Model.Dashboard.History)
                                {
                                    var date = request.CompletedAtUtc ?? request.EscalatedAtUtc ?? request.CreatedAtUtc;
                                    var statusBadgeClass = request.Status switch
                                    {
                                        SupportRequestStatus.Completed => "bg-info",
                                        SupportRequestStatus.Escalated => "bg-warning text-dark",
                                        _ => "bg-secondary"
                                    };
                                    <div class="list-group-item">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div class="flex-grow-1">
                                                <h6 class="mb-1">@request.Title</h6>
                                                <p class="mb-1 text-muted">
                                                    <span class="badge @statusBadgeClass">@request.Status</span>
                                                    <span class="badge bg-secondary">@request.Category</span>
                                                    @if (request.Status == SupportRequestStatus.Escalated)
                                                    {
                                                        if (request.EscalationHandledAtUtc is DateTime handled)
                                                        {
                                                            <span class="badge bg-success" title="A counselor took this on @handled.ToString("MMM d")">Counselor following up</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-light text-dark border">Awaiting counselor</span>
                                                        }
                                                    }
                                                </p>
                                                <small class="text-muted">@date.ToString("MMM d, yyyy")</small>
                                            </div>
                                            <a href="@Url.Action("ViewRequest", "Volunteer", new { requestId = request.Id })" class="btn btn-sm btn-outline-secondary">
                                                View Request
                                            </a>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="col-lg-4">
                <div class="card">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">Quick Tips</h5>
                    </div>
                    <div class="card-body">
                        <p><strong>Before you accept:</strong></p>
                        <ul class="small">
                            <li>Make sure you have time to help</li>
                            <li>Review the student's request carefully</li>
                            <li>Respond within 24-48 hours</li>
                        </ul>

                        <p class="mt-3"><strong>During support:</strong></p>
                        <ul class="small">
                            <li>Keep conversations focused and respectful</li>
                            <li>Listen without judgment</li>
                            <li>If you feel concerns require professional help, escalate to a counselor</li>
                        </ul>

                        <p class="mt-3"><strong>Need to escalate?</strong></p>
                        <p class="small">If a student mentions self-harm, crisis, or needs professional help, you can escalate the request to our counseling team through the "Escalate to Counselor" option in each request.</p>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.0/dist/browser/signalr.min.js" crossorigin="anonymous"></script>
    <script src="~/js/peer-support.js" asp-append-version="true"></script>
}
