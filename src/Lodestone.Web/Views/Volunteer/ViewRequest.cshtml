@model VolunteerViewRequestViewModel
@using Lodestone.Application.DTOs.Volunteer
@using Lodestone.Domain.Enums
@{
    ViewData["Title"] = Model.Request.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/peer-support.css" asp-append-version="true" />
}

<div class="container my-5">
    <div class="row mb-4">
        <div class="col-12">
            <a href="@Url.Action("Dashboard", "Volunteer")" class="btn btn-outline-secondary btn-sm mb-3">← Back to Dashboard</a>
            <h1>@Model.Request.Title</h1>
            <p class="text-muted">
                <span class="badge bg-secondary">@Model.Request.Category</span>
                <span class="text-muted ms-2">Posted @Model.Request.CreatedAtUtc.ToString("MMM d, yyyy 'at' h:mm tt")</span>
            </p>
        </div>
    </div>

    @if (TempData["SupportSuccess"] is string success)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @success
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["SupportError"] is string error)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @error
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Request Details</h5>
                </div>
                <div class="card-body">
                    <p class="lead">@Model.Request.Message</p>
                    @if (!string.IsNullOrWhiteSpace(Model.Request.Availability))
                    {
                        <p class="text-muted"><strong>Student availability:</strong> @Model.Request.Availability</p>
                    }
                </div>
            </div>

            @if (Model.Request.Status == SupportRequestStatus.Pending)
            {
                <div class="card mb-4">
                    <div class="card-body">
                        <p class="text-muted mb-3">This request is pending and needs your help. Do you want to accept it?</p>
                        <form asp-controller="Volunteer" asp-action="AcceptRequest" asp-route-requestId="@Model.Request.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-check-circle"></i>
                                Accept Request
                            </button>
                        </form>
                        <form asp-controller="Volunteer" asp-action="RejectRequest" asp-route-requestId="@Model.Request.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger">
                                <i class="bi bi-x-circle"></i>
                                Decline Request
                            </button>
                        </form>
                    </div>
                </div>
            }
            else if (Model.Request.Status == SupportRequestStatus.Accepted)
            {
                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">Conversation</h5>
                    </div>
                    <div class="card-body">
                        @if (Model.Request.Interactions.Count == 0)
                        {
                            <p class="text-muted">No interactions yet. Start helping!</p>
                        }
                        else
                        {
                            <div class="mb-4">
                                @foreach (var interaction in Model.Request.Interactions)
                                {
                                    <div class="mb-3 p-3 bg-light rounded">
                                        <div class="d-flex justify-content-between mb-2">
                                            <strong>
                                                @if (interaction.IsFromVolunteer)
                                                {
                                                    <span>You</span>
                                                }
                                                else
                                                {
                                                    <span>Student</span>
                                                }
                                            </strong>
                                            <small class="text-muted">@interaction.CreatedAtUtc.ToString("MMM d, yyyy 'at' h:mm tt")</small>
                                        </div>
                                        <p class="mb-0">@interaction.Message</p>
                                        @if (interaction.EscalatedToCounselor)
                                        {
                                            <p class="mb-0 mt-2">
                                                <span class="badge bg-warning text-dark">Escalated to Counselor</span>
                                            </p>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">Add Your Response</h5>
                    </div>
                    <div class="card-body">
                        <form asp-controller="Volunteer" asp-action="AddInteraction" asp-route-requestId="@Model.Request.Id" method="post">
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                <label asp-for="Interaction.Message" class="form-label">Your Message</label>
                                <textarea class="form-control" asp-for="Interaction.Message" rows="4" placeholder="Share your thoughts and guidance..."></textarea>
                                <small class="form-text text-muted">Keep your response supportive and respectful.</small>
                                <span asp-validation-for="Interaction.Message" class="text-danger small d-block"></span>
                            </div>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-send"></i>
                                Send Message
                            </button>
                        </form>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-body">
                        <div class="d-flex gap-2 flex-wrap">
                            <form asp-controller="Volunteer" asp-action="CompleteRequest" asp-route-requestId="@Model.Request.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-success">
                                    <i class="bi bi-check2-all"></i>
                                    Mark Complete
                                </button>
                            </form>
                            <form asp-controller="Volunteer" asp-action="EscalateRequest" asp-route-requestId="@Model.Request.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <div class="mb-2">
                                    <textarea class="form-control form-control-sm" asp-for="Escalation.Message" rows="2" placeholder="Optional escalation note for counselors..."></textarea>
                                </div>
                                <button type="submit" class="btn btn-outline-warning">
                                    <i class="bi bi-exclamation-triangle"></i>
                                    Escalate to Counselor
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
            else
            {
                @* Completed or Escalated — read-only history *@
                @if (Model.Request.Interactions.Count > 0)
                {
                    <div class="card mb-4">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">Conversation History</h5>
                        </div>
                        <div class="card-body">
                            @foreach (var interaction in Model.Request.Interactions)
                            {
                                <div class="mb-3 p-3 bg-light rounded">
                                    <div class="d-flex justify-content-between mb-2">
                                        <strong>
                                            @if (interaction.IsFromVolunteer)
                                            {
                                                <span>You</span>
                                            }
                                            else
                                            {
                                                <span>Student</span>
                                            }
                                        </strong>
                                        <small class="text-muted">@interaction.CreatedAtUtc.ToString("MMM d, yyyy 'at' h:mm tt")</small>
                                    </div>
                                    <p class="mb-0">@interaction.Message</p>
                                    @if (interaction.EscalatedToCounselor)
                                    {
                                        <p class="mb-0 mt-2">
                                            <span class="badge bg-warning text-dark">Escalated to Counselor</span>
                                        </p>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Request Status</h5>
                </div>
                <div class="card-body">
                    <p class="mb-2">
                        <strong>Status:</strong>
                        @{
                            var statusBadgeClass = Model.Request.Status switch
                            {
                                SupportRequestStatus.Pending => "bg-secondary",
                                SupportRequestStatus.Accepted => "bg-success",
                                SupportRequestStatus.Completed => "bg-info",
                                SupportRequestStatus.Escalated => "bg-warning text-dark",
                                _ => "bg-secondary"
                            };
                        }
                        <span class="badge @statusBadgeClass">@Model.Request.Status</span>
                    </p>

                    <p class="mb-2">
                        <strong>Student:</strong><br />
                        @Model.Request.StudentDisplayName
                    </p>

                    <p class="mb-0">
                        <strong>Posted:</strong><br />
                        @Model.Request.CreatedAtUtc.ToString("MMM d, yyyy")
                    </p>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Guidelines</h5>
                </div>
                <div class="card-body">
                    <ul class="small">
                        <li><strong>Listen first</strong> - Understand the student's perspective</li>
                        <li><strong>Stay supportive</strong> - Peer support is about care and understanding</li>
                        <li><strong>Know your limits</strong> - Escalate if professional help is needed</li>
                        <li><strong>Respect privacy</strong> - Keep conversations confidential</li>
                        <li><strong>Follow up</strong> - Check in after you help</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
