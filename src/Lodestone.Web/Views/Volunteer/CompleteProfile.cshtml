@model Lodestone.Web.ViewModels.Volunteer.CompleteVolunteerProfileViewModel
@{
    ViewData["Title"] = "Complete your volunteer profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/volunteer.css" asp-append-version="true" />
}

<div class="volunteer-page">
    <header class="volunteer-page__header">
        <span class="volunteer-page__eyebrow">Peer support</span>
        <h1 class="volunteer-page__title">Complete your profile</h1>
        <p class="volunteer-page__lede">
            Tell us a little about yourself. An administrator reviews your profile before you can
            take peer-support requests, so the detail here helps them match you to students.
        </p>
    </header>

    <form class="volunteer-form" asp-action="CompleteProfile" method="post">
        <div asp-validation-summary="ModelOnly" class="volunteer-alert volunteer-alert--error" role="alert"></div>

        <div class="volunteer-field">
            <label asp-for="FullName"></label>
            <input asp-for="FullName" autocomplete="name" autofocus />
            <span class="field-validation-error" asp-validation-for="FullName"></span>
        </div>

        <div class="volunteer-field">
            <label asp-for="Department"></label>
            <input asp-for="Department" placeholder="For example: Computer Science" />
            <span class="field-validation-error" asp-validation-for="Department"></span>
        </div>

        <div class="volunteer-field">
            <label asp-for="Skills"></label>
            <input asp-for="Skills" placeholder="For example: study planning, first-year transition" />
            <p class="volunteer-field__help">What you feel confident helping another student with.</p>
            <span class="field-validation-error" asp-validation-for="Skills"></span>
        </div>

        <div class="volunteer-field">
            <label asp-for="Availability"></label>
            <textarea asp-for="Availability" rows="2" placeholder="For example: weekday evenings"></textarea>
            <span class="field-validation-error" asp-validation-for="Availability"></span>
        </div>

        <div class="volunteer-field">
            <label asp-for="Bio"></label>
            <textarea asp-for="Bio" rows="4"></textarea>
            <p class="volunteer-field__help">A short introduction students may see when you support them.</p>
            <span class="field-validation-error" asp-validation-for="Bio"></span>
        </div>

        <div class="volunteer-form__footer">
            <p>
                Only your name and the details you enter here are shared. You will not see any
                student information until an administrator approves you and assigns you to students.
            </p>
            <button class="volunteer-submit" type="submit">Submit for approval</button>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
