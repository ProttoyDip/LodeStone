@model CreateVolunteerViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Add volunteer";
}

<div class="ls-admin-page">
    <header class="ls-admin-page-header">
        <div class="ls-admin-page-header__content">
            <p class="ls-admin-page-header__eyebrow">People &amp; access</p>
            <h1>Add volunteer</h1>
            <p>Create the account without a shared password. The volunteer receives a secure setup link and can take peer-support requests once they are approved and assigned to students.</p>
        </div>
        <a class="ls-admin-btn ls-admin-btn--secondary" asp-action="Index">Back to volunteers</a>
    </header>

    @if (TempData["AdminSuccess"] is string success)
    {
        <div class="ls-admin-alert ls-admin-alert--success" role="status">@success</div>
    }
    @if (TempData["AdminError"] is string error)
    {
        <div class="ls-admin-alert ls-admin-alert--error" role="alert">@error</div>
    }

    <section class="ls-admin-panel" aria-labelledby="create-volunteer-heading">
        <header class="ls-admin-panel__header">
            <h2 id="create-volunteer-heading">Account details</h2>
        </header>
        <div class="ls-admin-panel__body">
            <form asp-action="Create" method="post" class="ls-admin-form">
                <div asp-validation-summary="ModelOnly" class="ls-admin-alert ls-admin-alert--error" role="alert"></div>

                <div class="ls-admin-field">
                    <label asp-for="FullName"></label>
                    <input class="ls-admin-input" asp-for="FullName" autocomplete="name" />
                    <span asp-validation-for="FullName"></span>
                </div>

                <div class="ls-admin-field">
                    <label asp-for="Email"></label>
                    <input class="ls-admin-input" asp-for="Email" autocomplete="email" />
                    <span asp-validation-for="Email"></span>
                </div>

                <div class="ls-admin-field">
                    <label asp-for="Department"></label>
                    <input class="ls-admin-input" asp-for="Department" />
                    <span asp-validation-for="Department"></span>
                </div>

                <div class="ls-admin-field">
                    <label asp-for="Skills"></label>
                    <input class="ls-admin-input" asp-for="Skills" placeholder="For example: study planning, first-year transition" />
                    <span asp-validation-for="Skills"></span>
                </div>

                <div class="ls-admin-field">
                    <label asp-for="Availability"></label>
                    <textarea class="ls-admin-input" asp-for="Availability" rows="2" placeholder="For example: weekday evenings"></textarea>
                    <span asp-validation-for="Availability"></span>
                </div>

                <div class="ls-admin-field">
                    <label asp-for="Bio"></label>
                    <textarea class="ls-admin-input" asp-for="Bio" rows="3"></textarea>
                    <span asp-validation-for="Bio"></span>
                </div>

                <div class="ls-admin-field ls-admin-field--check">
                    <label>
                        <input asp-for="ApproveImmediately" type="checkbox" />
                        <span>@Html.DisplayNameFor(model => model.ApproveImmediately)</span>
                    </label>
                    <small>Leave this checked if you are vouching for the volunteer. Clear it to send the account to the approval queue instead.</small>
                </div>

                <button class="ls-admin-btn ls-admin-btn--primary" type="submit">Create and send setup link</button>
            </form>
        </div>
    </section>

    <section class="ls-admin-panel" aria-labelledby="resend-volunteer-heading">
        <header class="ls-admin-panel__header">
            <h2 id="resend-volunteer-heading">Resend setup link</h2>
        </header>
        <div class="ls-admin-panel__body">
            <form asp-action="ResendSetup" method="post" class="ls-admin-form">
                <div class="ls-admin-field">
                    <label for="resend-volunteer-email">Volunteer email</label>
                    <input class="ls-admin-input" id="resend-volunteer-email" name="email" type="email" required />
                </div>
                <button class="ls-admin-btn ls-admin-btn--secondary" type="submit">Resend setup link</button>
            </form>
        </div>
    </section>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
