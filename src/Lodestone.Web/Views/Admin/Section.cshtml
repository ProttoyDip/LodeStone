@model AdminSectionViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = Model.Page.Title;

    var query = Context.Request.Query["q"].ToString();
    var successMessage = TempData["Success"] as string ?? TempData["AdminSuccess"] as string;
    var errorMessage = TempData["Error"] as string ?? TempData["AdminError"] as string;
    var hasRowActions = Model.Page.Section is AdminSectionType.ForumModeration or AdminSectionType.Notifications;

    bool IsUnread(AdminSectionRowDto row)
    {
        if (string.Equals(row.BadgeText, "Unread", StringComparison.OrdinalIgnoreCase)
            || string.Equals(row.BadgeText, "New", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        return row.Cells.Any(cell =>
            string.Equals(cell.Value, "Unread", StringComparison.OrdinalIgnoreCase)
            || (string.Equals(cell.Key, "isRead", StringComparison.OrdinalIgnoreCase)
                && string.Equals(cell.Value, "false", StringComparison.OrdinalIgnoreCase)));
    }

    var hasUnreadNotifications = Model.Page.Section == AdminSectionType.Notifications
        && Model.Page.Rows.Any(IsUnread);

    var totalPages = Model.Page.PageSize > 0
        ? Math.Max(1, (int)Math.Ceiling(Model.Page.TotalCount / (double)Model.Page.PageSize))
        : 1;
    var currentPage = Math.Clamp(Model.Page.Page, 1, totalPages);
    var firstRowNumber = Model.Page.Rows.Count == 0 ? 0 : ((currentPage - 1) * Model.Page.PageSize) + 1;
    var lastRowNumber = ((currentPage - 1) * Model.Page.PageSize) + Model.Page.Rows.Count;
}

<div class="ls-admin-page">
    <header class="ls-admin-page-header">
        <div class="ls-admin-page-header__content">
            <p class="ls-admin-page-header__eyebrow">@Model.Page.Eyebrow</p>
            <h1>@Model.Page.Title</h1>
            <p>@Model.Page.Subtitle</p>
        </div>
        <div class="ls-admin-page-actions">
            @if (Model.Page.Section == AdminSectionType.Counselors)
            {
                <a class="ls-admin-btn ls-admin-btn--primary" asp-controller="Admin" asp-action="CreateCounselor">
                    <i class="bi bi-person-plus" aria-hidden="true"></i>
                    Create counselor
                </a>
            }
            @if (hasUnreadNotifications)
            {
                <form asp-controller="Admin" asp-action="MarkAllNotificationsRead" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="q" value="@query" />
                    <button class="ls-admin-btn ls-admin-btn--secondary" type="submit">
                        <i class="bi bi-check2-all" aria-hidden="true"></i>
                        Mark all read
                    </button>
                </form>
            }
            <a class="ls-admin-btn ls-admin-btn--secondary" asp-controller="Admin" asp-action="Index">
                <i class="bi bi-arrow-left" aria-hidden="true"></i>
                Dashboard
            </a>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="ls-admin-alert ls-admin-alert--success" role="status">
            <i class="bi bi-check-circle" aria-hidden="true"></i>
            <span>@successMessage</span>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="ls-admin-alert ls-admin-alert--error" role="alert">
            <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
            <span>@errorMessage</span>
        </div>
    }

    @if (Model.Page.Metrics.Count > 0)
    {
        <section aria-labelledby="section-summary-heading">
            <h2 class="ls-admin-sr-only" id="section-summary-heading">@Model.Page.Title summary</h2>
            <div class="ls-admin-kpi-grid ls-admin-kpi-grid--compact">
                @foreach (var metric in Model.Page.Metrics)
                {
                    <article class="ls-admin-kpi ls-admin-kpi--compact ls-admin-kpi--@metric.Tone">
                        <span class="ls-admin-kpi__label">@metric.Label</span>
                        <strong class="ls-admin-kpi__value">@metric.Value</strong>
                    </article>
                }
            </div>
        </section>
    }

    <section class="ls-admin-panel" aria-labelledby="section-records-heading">
        <header class="ls-admin-panel__header ls-admin-panel__header--toolbar">
            <div>
                <p class="ls-admin-panel__eyebrow">Live records</p>
                <h2 id="section-records-heading">@Model.Page.Title</h2>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Page.SearchPlaceholder))
            {
                <form class="ls-admin-toolbar" method="get" role="search">
                    <label class="ls-admin-sr-only" for="admin-section-search">Search @Model.Page.Title</label>
                    <div class="ls-admin-field ls-admin-field--search">
                        <i class="bi bi-search" aria-hidden="true"></i>
                        <input class="ls-admin-input"
                               id="admin-section-search"
                               name="q"
                               type="search"
                               value="@query"
                               maxlength="100"
                               placeholder="@Model.Page.SearchPlaceholder" />
                    </div>
                    <button class="ls-admin-btn ls-admin-btn--secondary" type="submit">Search</button>
                    @if (!string.IsNullOrWhiteSpace(query))
                    {
                        <a class="ls-admin-btn ls-admin-btn--quiet" href="@Context.Request.Path">Clear</a>
                    }
                </form>
            }
        </header>

        <div class="ls-admin-panel__body ls-admin-panel__body--flush">
            @if (Model.Page.Rows.Count == 0)
            {
                <div class="ls-admin-empty">
                    <i class="bi bi-inbox" aria-hidden="true"></i>
                    <h3>No records to show</h3>
                    <p>@(Model.Page.EmptyStateMessage ?? "There are no records in this section yet.")</p>
                    @if (!string.IsNullOrWhiteSpace(query))
                    {
                        <a class="ls-admin-btn ls-admin-btn--secondary" href="@Context.Request.Path">Clear search</a>
                    }
                </div>
            }
            else
            {
                <div class="ls-admin-table-wrap">
                    <table class="ls-admin-table">
                        <caption class="ls-admin-sr-only">@Model.Page.Title records</caption>
                        <thead>
                            <tr>
                                @foreach (var column in Model.Page.Columns)
                                {
                                    <th class="@column.CssClass" scope="col">@column.Label</th>
                                }
                                @if (hasRowActions)
                                {
                                    <th class="ls-admin-table__actions-heading" scope="col">Actions</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.Page.Rows)
                            {
                                <tr>
                                    @for (var columnIndex = 0; columnIndex < Model.Page.Columns.Count; columnIndex++)
                                    {
                                        var column = Model.Page.Columns[columnIndex];
                                        row.Cells.TryGetValue(column.Key, out var cellValue);

                                        @if (columnIndex == 0)
                                        {
                                            <th class="@column.CssClass" scope="row" data-label="@column.Label">
                                                <div class="ls-admin-table__primary">@row.PrimaryLabel</div>
                                                @if (!string.IsNullOrWhiteSpace(row.SecondaryLabel))
                                                {
                                                    <div class="ls-admin-table__secondary">@row.SecondaryLabel</div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(row.BadgeText))
                                                {
                                                    <span class="ls-admin-badge ls-admin-badge--@row.BadgeClass">@row.BadgeText</span>
                                                }
                                            </th>
                                        }
                                        else
                                        {
                                            <td class="@column.CssClass" data-label="@column.Label">
                                                <span class="@(column.IsNumeric ? "ls-admin-table__number" : string.Empty)">
                                                    @if (string.IsNullOrWhiteSpace(cellValue))
                                                    {
                                                        <span aria-label="Not available">&mdash;</span>
                                                    }
                                                    else
                                                    {
                                                        @cellValue
                                                    }
                                                </span>
                                            </td>
                                        }
                                    }

                                    @if (hasRowActions)
                                    {
                                        <td class="ls-admin-table__actions" data-label="Actions">
                                            @if (Model.Page.Section == AdminSectionType.ForumModeration)
                                            {
                                                <form asp-controller="Admin"
                                                      asp-action="ReviewForumPost"
                                                      method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="postId" value="@row.Id" />
                                                    <input type="hidden" name="publish" value="true" />
                                                    <input type="hidden" name="q" value="@query" />
                                                    <button class="ls-admin-btn ls-admin-btn--small ls-admin-btn--secondary" type="submit">Approve</button>
                                                </form>
                                                <form asp-controller="Admin"
                                                      asp-action="ReviewForumPost"
                                                      method="post"
                                                      data-admin-confirm="Remove this discussion from the community?">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="postId" value="@row.Id" />
                                                    <input type="hidden" name="publish" value="false" />
                                                    <input type="hidden" name="q" value="@query" />
                                                    <button class="ls-admin-btn ls-admin-btn--small ls-admin-btn--danger" type="submit">Remove</button>
                                                </form>
                                            }
                                            else if (Model.Page.Section == AdminSectionType.Notifications && IsUnread(row))
                                            {
                                                <form asp-controller="Admin" asp-action="MarkNotificationRead" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@row.Id" />
                                                    <input type="hidden" name="q" value="@query" />
                                                    <button class="ls-admin-btn ls-admin-btn--small ls-admin-btn--secondary" type="submit">Mark read</button>
                                                </form>
                                            }
                                            else
                                            {
                                                <span class="ls-admin-table__no-action" aria-label="No action available">&mdash;</span>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (totalPages > 1)
                {
                    <nav class="ls-admin-pager" aria-label="@Model.Page.Title pagination">
                        <span class="ls-admin-pager__summary">
                            Showing @firstRowNumber&ndash;@lastRowNumber of @Model.Page.TotalCount.ToString("N0")
                        </span>
                        <div class="ls-admin-pager__controls">
                            @if (currentPage > 1)
                            {
                                <a class="ls-admin-btn ls-admin-btn--small ls-admin-btn--secondary"
                                   asp-all-route-data="@(new Dictionary<string, string> { ["q"] = query, ["page"] = (currentPage - 1).ToString() })">
                                    <i class="bi bi-chevron-left" aria-hidden="true"></i>
                                    Previous
                                </a>
                            }
                            <span class="ls-admin-pager__page">Page @currentPage of @totalPages</span>
                            @if (currentPage < totalPages)
                            {
                                <a class="ls-admin-btn ls-admin-btn--small ls-admin-btn--secondary"
                                   asp-all-route-data="@(new Dictionary<string, string> { ["q"] = query, ["page"] = (currentPage + 1).ToString() })">
                                    Next
                                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                                </a>
                            }
                        </div>
                    </nav>
                }
            }
        </div>
    </section>
</div>
