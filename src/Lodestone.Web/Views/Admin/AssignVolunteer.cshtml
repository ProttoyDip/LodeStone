@using Lodestone.Application.DTOs.Volunteer
@model AdminVolunteerAssignmentViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Assign volunteer";

    var successMessage = TempData["AdminSuccess"] as string;
    var errorMessage = TempData["AdminError"] as string;

    var distinctPrograms = Model.Options.Groups
        .Select(g => g.Program)
        .Concat(Model.Options.Students.Select(s => s.Program ?? string.Empty))
        .Where(p => !string.IsNullOrWhiteSpace(p))
        .Distinct()
        .OrderBy(p => p)
        .ToList();

    var distinctYears = Model.Options.Groups
        .Select(g => g.EnrollmentYear)
        .Concat(Model.Options.Students.Select(s => s.EnrollmentYear))
        .Where(y => y > 0)
        .Distinct()
        .OrderByDescending(y => y)
        .ToList();

    if (distinctYears.Count == 0)
    {
        var currentYear = DateTime.UtcNow.Year;
        distinctYears = Enumerable.Range(currentYear - 4, 6).Reverse().ToList();
    }
}

<div class="ls-admin-page">
    <header class="ls-admin-page-header">
        <div class="ls-admin-page-header__content">
            <p class="ls-admin-page-header__eyebrow">Community</p>
            <h1>Assign volunteer</h1>
            <p>Assigning @Model.Options.Volunteer.FullName</p>
        </div>
        <div class="ls-admin-page-actions">
            <a class="ls-admin-btn ls-admin-btn--secondary" href="/Admin/Volunteers">Back to volunteers</a>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="ls-admin-alert ls-admin-alert--success" role="status">
            <i class="bi bi-check-circle" aria-hidden="true"></i>
            <span>@successMessage</span>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="ls-admin-alert ls-admin-alert--error" role="alert">
            <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
            <span>@errorMessage</span>
        </div>
    }

    <section class="ls-admin-panel" aria-labelledby="volunteer-profile-heading">
        <header class="ls-admin-panel__header">
            <div>
                <p class="ls-admin-panel__eyebrow">Profile</p>
                <h2 id="volunteer-profile-heading">Volunteer summary</h2>
            </div>
            @if (Model.Options.Volunteer.IsApproved && Model.Options.Volunteer.IsActive)
            {
                <span class="ls-admin-badge ls-admin-badge--success">Active</span>
            }
            else if (Model.Options.Volunteer.IsApproved)
            {
                <span class="ls-admin-badge ls-admin-badge--neutral">Inactive</span>
            }
            else
            {
                <span class="ls-admin-badge ls-admin-badge--warning">Pending</span>
            }
        </header>
        <div class="ls-admin-panel__body">
            <div class="ls-admin-mini-grid">
                <div class="ls-admin-mini-metric">
                    <span class="ls-admin-mini-metric__label">Name</span>
                    <strong class="ls-admin-mini-metric__value">@Model.Options.Volunteer.FullName</strong>
                </div>
                <div class="ls-admin-mini-metric">
                    <span class="ls-admin-mini-metric__label">Department</span>
                    <strong class="ls-admin-mini-metric__value">@(Model.Options.Volunteer.Department ?? "—")</strong>
                </div>
                <div class="ls-admin-mini-metric">
                    <span class="ls-admin-mini-metric__label">Skills</span>
                    <strong class="ls-admin-mini-metric__value">@(Model.Options.Volunteer.Skills ?? "—")</strong>
                </div>
                <div class="ls-admin-mini-metric">
                    <span class="ls-admin-mini-metric__label">Availability</span>
                    <strong class="ls-admin-mini-metric__value">@(Model.Options.Volunteer.Availability ?? "—")</strong>
                </div>
            </div>
        </div>
    </section>

    <section class="ls-admin-panel" aria-labelledby="assign-heading">
        <header class="ls-admin-panel__header">
            <div>
                <p class="ls-admin-panel__eyebrow">Assignment</p>
                <h2 id="assign-heading">Assign peer mentor</h2>
                <p>Select whether to match this volunteer with a specific student or an entire cohort group.</p>
            </div>
        </header>
        <div class="ls-admin-panel__body">
            <form method="post" action="/Admin/Volunteers/@Model.Options.Volunteer.Id/assign" class="ls-admin-form">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Input.VolunteerProfileId" value="@Model.Options.Volunteer.Id" />

                <div asp-validation-summary="ModelOnly" class="ls-admin-alert ls-admin-alert--error" role="alert"></div>

                <div class="ls-admin-field">
                    <label asp-for="Input.Target">Target</label>
                    <select class="ls-admin-select" asp-for="Input.Target" id="Input_Target">
                        <option value="0" selected="@(Model.Input.Target != VolunteerAssignmentTarget.Group ? "selected" : null)">Student</option>
                        <option value="1" selected="@(Model.Input.Target == VolunteerAssignmentTarget.Group ? "selected" : null)">Group</option>
                    </select>
                    <span class="ls-admin-field-validation" asp-validation-for="Input.Target"></span>
                </div>

                <div class="ls-admin-field" id="student-fields">
                    <label asp-for="Input.StudentProfileId">Student</label>
                    <select class="ls-admin-select" asp-for="Input.StudentProfileId" id="Input_StudentProfileId">
                        <option value="">-- Select a student --</option>
                        @foreach (var student in Model.Options.Students)
                        {
                            <option value="@student.StudentProfileId">
                                @student.DisplayName (@(student.Program ?? "General"), Year @student.EnrollmentYear)
                            </option>
                        }
                    </select>
                    <span class="ls-admin-field-validation" asp-validation-for="Input.StudentProfileId"></span>
                </div>

                <div id="group-fields" style="display: none;">
                    <div class="ls-admin-field">
                        <label asp-for="Input.Program">Program</label>
                        <select class="ls-admin-select" asp-for="Input.Program" id="Input_Program">
                            <option value="">-- Select a program --</option>
                            @foreach (var program in distinctPrograms)
                            {
                                <option value="@program">@program</option>
                            }
                        </select>
                        <span class="ls-admin-field-validation" asp-validation-for="Input.Program"></span>
                    </div>

                    <div class="ls-admin-field" style="margin-top: 1rem;">
                        <label asp-for="Input.EnrollmentYear">Enrollment year</label>
                        <select class="ls-admin-select" asp-for="Input.EnrollmentYear" id="Input_EnrollmentYear">
                            <option value="">-- Select an enrollment year --</option>
                            @foreach (var year in distinctYears)
                            {
                                <option value="@year">@year</option>
                            }
                        </select>
                        <span class="ls-admin-field-validation" asp-validation-for="Input.EnrollmentYear"></span>
                    </div>
                </div>

                <div class="ls-admin-field">
                    <label asp-for="Input.Role">Role</label>
                    <input class="ls-admin-input" asp-for="Input.Role" />
                    <span class="ls-admin-field-validation" asp-validation-for="Input.Role"></span>
                </div>

                <div class="ls-admin-field">
                    <label asp-for="Input.Notes">Notes</label>
                    <textarea class="ls-admin-input" asp-for="Input.Notes" rows="3"></textarea>
                    <span class="ls-admin-field-validation" asp-validation-for="Input.Notes"></span>
                </div>

                <button class="ls-admin-btn ls-admin-btn--primary" type="submit">Save assignment</button>
            </form>
        </div>
    </section>

    <section class="ls-admin-panel" aria-labelledby="active-assignments-heading">
        <header class="ls-admin-panel__header">
            <div>
                <p class="ls-admin-panel__eyebrow">Current duties</p>
                <h2 id="active-assignments-heading">Active assignments</h2>
                <p>Students and cohorts currently assigned to @Model.Options.Volunteer.FullName.</p>
            </div>
            <span class="ls-admin-badge ls-admin-badge--neutral">@Model.Options.ActiveAssignments.Count active</span>
        </header>
        <div class="ls-admin-panel__body ls-admin-panel__body--flush">
            @if (Model.Options.ActiveAssignments.Count == 0)
            {
                <div class="ls-admin-empty ls-admin-empty--compact">
                    <p>No active assignments for this volunteer.</p>
                </div>
            }
            else
            {
                <div class="ls-admin-table-wrap">
                    <table class="ls-admin-table">
                        <caption class="ls-admin-sr-only">Active assignments for @Model.Options.Volunteer.FullName</caption>
                        <thead>
                            <tr>
                                <th scope="col">Student</th>
                                <th scope="col">Program</th>
                                <th scope="col">Year</th>
                                <th scope="col">Role</th>
                                <th scope="col">Group</th>
                                <th scope="col">Assigned date</th>
                                <th scope="col" class="ls-admin-table__actions-heading">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var assignment in Model.Options.ActiveAssignments)
                            {
                                <tr>
                                    <th scope="row" data-label="Student">
                                        <div class="ls-admin-table__primary">@assignment.StudentDisplayName</div>
                                        @if (!string.IsNullOrWhiteSpace(assignment.Notes))
                                        {
                                            <div class="ls-admin-table__secondary">@assignment.Notes</div>
                                        }
                                    </th>
                                    <td data-label="Program">@(assignment.Program ?? "—")</td>
                                    <td data-label="Year">@(assignment.EnrollmentYear > 0 ? assignment.EnrollmentYear.ToString() : "—")</td>
                                    <td data-label="Role">@assignment.Role</td>
                                    <td data-label="Group">@(assignment.GroupName ?? "—")</td>
                                    <td data-label="Assigned date">
                                        <time datetime="@assignment.AssignedAtUtc.ToString("O")">@assignment.AssignedAtUtc.ToString("dd MMM yyyy")</time>
                                    </td>
                                    <td class="ls-admin-table__actions" data-label="Actions">
                                        <form method="post" action="/Admin/Volunteers/@Model.Options.Volunteer.Id/assignments/@assignment.Id/deactivate">
                                            @Html.AntiForgeryToken()
                                            <button class="ls-admin-btn ls-admin-btn--danger" type="submit">Deactivate</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        var targetSelect = document.getElementById('Input_Target');
        var studentFields = document.getElementById('student-fields');
        var groupFields = document.getElementById('group-fields');
        function toggleFields() {
            var val = targetSelect ? targetSelect.value : '';
            if (studentFields) studentFields.style.display = val === '0' ? '' : 'none';
            if (groupFields) groupFields.style.display = val === '1' ? '' : 'none';
        }
        if (targetSelect) { targetSelect.addEventListener('change', toggleFields); toggleFields(); }
    });
    </script>
}
