@model AdminDashboardViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Support operations";

    var dashboard = Model.Dashboard;
    var successMessage = TempData["Success"] as string ?? TempData["AdminSuccess"] as string;
    var errorMessage = TempData["Error"] as string ?? TempData["AdminError"] as string;
    var riskRuntime = Model.RiskRuntime;
    var latestRiskRun = riskRuntime?.LatestRun;
    var maximumRiskSignals = Math.Max(1, dashboard.RiskTrend.Count == 0
        ? 0
        : dashboard.RiskTrend.Max(point => point.Total));
}

<div class="ls-admin-page ls-admin-page--dashboard">
    <header class="ls-admin-page-header">
        <div class="ls-admin-page-header__content">
            <p class="ls-admin-page-header__eyebrow">Operations overview</p>
            <h1>Support operations</h1>
            <p>Prioritize people who may need support, keep appointments moving, and review community reports from one live workspace.</p>
            <p class="ls-admin-page-header__meta">
                <i class="bi bi-clock" aria-hidden="true"></i>
                Data as of @dashboard.Shell.CurrentDateLabel
            </p>
        </div>
        <div class="ls-admin-page-actions">
            <a class="ls-admin-btn ls-admin-btn--primary" asp-controller="Counselor" asp-action="Queue">
                Review support queue
                <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </a>
            <a class="ls-admin-btn ls-admin-btn--secondary" asp-controller="Admin" asp-action="RiskMonitoring">
                Risk operations
            </a>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="ls-admin-alert ls-admin-alert--success" role="status">
            <i class="bi bi-check-circle" aria-hidden="true"></i>
            <span>@successMessage</span>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="ls-admin-alert ls-admin-alert--error" role="alert">
            <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
            <span>@errorMessage</span>
        </div>
    }

    <section aria-labelledby="admin-summary-heading">
        <h2 class="ls-admin-sr-only" id="admin-summary-heading">Operational summary</h2>
        <div class="ls-admin-kpi-grid">
            @foreach (var kpi in dashboard.Kpis.Take(4))
            {
                <article class="ls-admin-kpi ls-admin-kpi--@kpi.Tone">
                    <div class="ls-admin-kpi__topline">
                        <span class="ls-admin-kpi__label">@kpi.Label</span>
                        <span class="ls-admin-kpi__icon" aria-hidden="true"><i class="bi @kpi.Icon"></i></span>
                    </div>
                    <strong class="ls-admin-kpi__value">@kpi.Value</strong>
                    <div class="ls-admin-kpi__footer">
                        <span>@kpi.Detail</span>
                        @if (string.Equals(kpi.Action, "RiskMonitoring", StringComparison.Ordinal))
                        {
                            <a asp-controller="Counselor" asp-action="Queue" aria-label="Open @kpi.Label">
                                View
                                <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
                            </a>
                        }
                        else
                        {
                            <a asp-controller="@kpi.Controller" asp-action="@kpi.Action" aria-label="Open @kpi.Label">
                                View
                                <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
                            </a>
                        }
                    </div>
                </article>
            }
        </div>
    </section>

    @if (riskRuntime is not null)
    {
        <section class="ls-admin-panel" aria-labelledby="runtime-model-heading">
            <header class="ls-admin-panel__header">
                <div>
                    <p class="ls-admin-panel__eyebrow">Machine learning</p>
                    <h2 id="runtime-model-heading">Runtime model status</h2>
                    <p>Only a validated model can score consented, verified student snapshots.</p>
                </div>
                <span class="ls-admin-badge tone-@riskRuntime.StateTone">@riskRuntime.StateLabel</span>
            </header>
            <div class="ls-admin-panel__body">
                @if (!riskRuntime.ModelStatus.IsAvailable)
                {
                    <div class="ls-admin-alert tone-@riskRuntime.StateTone" role="@(riskRuntime.ModelStatus.IsEnabled ? "alert" : "status")">
                        <i class="bi @(riskRuntime.ModelStatus.IsEnabled ? "bi-shield-x" : "bi-pause-circle")" aria-hidden="true"></i>
                        <span>
                            @riskRuntime.StateDescription
                            @if (!string.IsNullOrWhiteSpace(riskRuntime.UnavailableReason))
                            {
                                <text> @riskRuntime.UnavailableReason</text>
                            }
                        </span>
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(riskRuntime.StatusError))
                {
                    <div class="ls-admin-alert tone-warning" role="alert">
                        <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
                        <span>@riskRuntime.StatusError</span>
                    </div>
                }

                <ul class="ls-admin-status" role="list">
                    <li class="ls-admin-status__item">
                        <span class="ls-admin-status__marker ls-admin-status__marker--@riskRuntime.StateTone" aria-hidden="true"></span>
                        <div>
                            <span>Loaded model</span>
                            <strong>@riskRuntime.ModelVersion</strong>
                            <small>Feature schema: @riskRuntime.FeatureSchemaVersion</small>
                        </div>
                    </li>
                    @if (latestRiskRun is null)
                    {
                        <li class="ls-admin-status__item">
                            <span class="ls-admin-status__marker ls-admin-status__marker--neutral" aria-hidden="true"></span>
                            <div>
                                <span>Latest scoring run</span>
                                <strong>No run recorded</strong>
                                <small>Operational totals appear after the first eligible scoring batch.</small>
                            </div>
                        </li>
                    }
                    else
                    {
                        <li class="ls-admin-status__item">
                            <span class="ls-admin-status__marker ls-admin-status__marker--@(latestRiskRun.FailedCount > 0 ? "warning" : "positive")" aria-hidden="true"></span>
                            <div>
                                <span>Latest scoring run</span>
                                <strong>@latestRiskRun.Status &middot; @latestRiskRun.ScoredCount.ToString("N0") scored</strong>
                                <small>
                                    @latestRiskRun.SkippedCount.ToString("N0") skipped, @latestRiskRun.FailedCount.ToString("N0") failed,
                                    @latestRiskRun.QueueCreatedCount.ToString("N0") cases opened
                                    @if (latestRiskRun.CompletedAtUtc is { } completedAt)
                                    {
                                        <text> &middot; completed </text><time datetime="@completedAt.ToString("O")" data-local-datetime>@completedAt.ToString("dd MMM yyyy, HH:mm") UTC</time>
                                    }
                                </small>
                            </div>
                        </li>
                    }
                </ul>
                <div class="ls-admin-panel__footer">
                    <span>Open queue counts and full failure details are available in Risk operations.</span>
                    <a class="ls-admin-btn ls-admin-btn--secondary ls-admin-btn--sm" asp-controller="Admin" asp-action="RiskMonitoring">Open risk operations</a>
                </div>
            </div>
        </section>
    }

    <div class="ls-admin-grid--main">
        <section class="ls-admin-panel ls-admin-panel--queue" aria-labelledby="support-queue-heading">
            <header class="ls-admin-panel__header">
                <div>
                    <p class="ls-admin-panel__eyebrow">Care operations</p>
                    <h2 id="support-queue-heading">Support queue</h2>
                    <p>Open high-priority signals, ordered by risk level and then by longest-waiting first.</p>
                </div>
                <a class="ls-admin-btn ls-admin-btn--secondary" asp-controller="Counselor" asp-action="Queue">
                    Open queue
                </a>
            </header>
            <div class="ls-admin-panel__body">
                @if (dashboard.SupportRows.Count == 0)
                {
                    <div class="ls-admin-empty">
                        <i class="bi bi-check2-circle" aria-hidden="true"></i>
                        <h3>The queue is clear</h3>
                        <p>There are no open high-priority support signals right now.</p>
                    </div>
                }
                else
                {
                    @await Html.PartialAsync("_AdminDashboardTable", (dashboard.SupportColumns, dashboard.SupportRows))
                }
            </div>
        </section>

        <section class="ls-admin-panel ls-admin-panel--today" aria-labelledby="today-heading">
            <header class="ls-admin-panel__header">
                <div>
                    <p class="ls-admin-panel__eyebrow">Live workload</p>
                    <h2 id="today-heading">Today (UTC)</h2>
                </div>
            </header>
            <div class="ls-admin-panel__body">
                @if (dashboard.TodayItems.Count == 0)
                {
                    <div class="ls-admin-empty ls-admin-empty--compact">
                        <p>No new operational activity today.</p>
                    </div>
                }
                else
                {
                    <ul class="ls-admin-list" role="list">
                        @foreach (var item in dashboard.TodayItems)
                        {
                            <li class="ls-admin-list__item">
                                <span class="ls-admin-list__icon ls-admin-list__icon--@item.Tone" aria-hidden="true">
                                    <i class="bi @item.Icon"></i>
                                </span>
                                <div class="ls-admin-list__content">
                                    <strong>@item.Title</strong>
                                    <span>@item.Detail</span>
                                </div>
                                <span class="ls-admin-list__time">@item.TimeLabel</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </section>
    </div>

    <div class="ls-admin-grid--main ls-admin-grid--secondary">
        <section class="ls-admin-panel ls-admin-panel--trend" aria-labelledby="risk-trend-heading">
            <header class="ls-admin-panel__header">
                <div>
                    <p class="ls-admin-panel__eyebrow">Last seven days</p>
                    <h2 id="risk-trend-heading">Risk signal trend</h2>
                    <p>Daily scores by risk level. Counts represent generated signals, not diagnoses.</p>
                </div>
            </header>
            <div class="ls-admin-panel__body">
                @if (dashboard.RiskTrend.Count == 0)
                {
                    <div class="ls-admin-empty ls-admin-empty--compact">
                        <p>No risk scores have been generated in the last seven days.</p>
                    </div>
                }
                else
                {
                    <div class="ls-admin-trend">
                        <div class="ls-admin-trend__legend" aria-label="Risk level legend">
                            <span><i class="ls-admin-trend__key ls-admin-trend__key--low" aria-hidden="true"></i>Low</span>
                            <span><i class="ls-admin-trend__key ls-admin-trend__key--moderate" aria-hidden="true"></i>Moderate</span>
                            <span><i class="ls-admin-trend__key ls-admin-trend__key--high" aria-hidden="true"></i>High</span>
                            <span><i class="ls-admin-trend__key ls-admin-trend__key--critical" aria-hidden="true"></i>Critical</span>
                        </div>
                        <ul class="ls-admin-trend__rows" role="list">
                            @foreach (var point in dashboard.RiskTrend)
                            {
                                var lowWidth = (point.Low * 100d / maximumRiskSignals).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                                var moderateWidth = (point.Moderate * 100d / maximumRiskSignals).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                                var highWidth = (point.High * 100d / maximumRiskSignals).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                                var criticalWidth = (point.Critical * 100d / maximumRiskSignals).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

                                <li class="ls-admin-trend__row">
                                    <div class="ls-admin-trend__row-head">
                                        <strong>@point.Label</strong>
                                        <span>@point.Total total</span>
                                    </div>
                                    <div class="ls-admin-trend__bar" aria-hidden="true">
                                        <span class="ls-admin-trend__segment ls-admin-trend__segment--low" style="@($"width: {lowWidth}%")"></span>
                                        <span class="ls-admin-trend__segment ls-admin-trend__segment--moderate" style="@($"width: {moderateWidth}%")"></span>
                                        <span class="ls-admin-trend__segment ls-admin-trend__segment--high" style="@($"width: {highWidth}%")"></span>
                                        <span class="ls-admin-trend__segment ls-admin-trend__segment--critical" style="@($"width: {criticalWidth}%")"></span>
                                    </div>
                                    <dl class="ls-admin-trend__counts">
                                        <div><dt>Low</dt><dd>@point.Low</dd></div>
                                        <div><dt>Moderate</dt><dd>@point.Moderate</dd></div>
                                        <div><dt>High</dt><dd>@point.High</dd></div>
                                        <div><dt>Critical</dt><dd>@point.Critical</dd></div>
                                    </dl>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        </section>

        <section class="ls-admin-panel ls-admin-panel--status" aria-labelledby="data-status-heading">
            <header class="ls-admin-panel__header">
                <div>
                    <p class="ls-admin-panel__eyebrow">Data freshness</p>
                    <h2 id="data-status-heading">System status</h2>
                </div>
            </header>
            <div class="ls-admin-panel__body">
                @if (dashboard.StatusItems.Count == 0)
                {
                    <div class="ls-admin-empty ls-admin-empty--compact"><p>No status data is available.</p></div>
                }
                else
                {
                    <ul class="ls-admin-status" role="list">
                        @foreach (var status in dashboard.StatusItems)
                        {
                            <li class="ls-admin-status__item">
                                <span class="ls-admin-status__marker ls-admin-status__marker--@status.Tone" aria-hidden="true"></span>
                                <div>
                                    <span>@status.Label</span>
                                    <strong>@status.Value</strong>
                                    <small>@status.Detail</small>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </section>
    </div>

    <section class="ls-admin-panel" aria-labelledby="notifications-heading">
        <header class="ls-admin-panel__header">
            <div>
                <p class="ls-admin-panel__eyebrow">Admin account</p>
                <h2 id="notifications-heading">Recent notifications</h2>
                <p>Messages generated for your administrator account.</p>
            </div>
            <a class="ls-admin-btn ls-admin-btn--secondary" asp-controller="Admin" asp-action="Notifications">
                Notification center
            </a>
        </header>
        <div class="ls-admin-panel__body">
            @if (dashboard.NotificationRows.Count == 0)
            {
                <div class="ls-admin-empty ls-admin-empty--compact"><p>You have no recent notifications.</p></div>
            }
            else
            {
                @await Html.PartialAsync("_AdminDashboardTable", (dashboard.NotificationColumns, dashboard.NotificationRows))
            }
        </div>
    </section>
</div>
