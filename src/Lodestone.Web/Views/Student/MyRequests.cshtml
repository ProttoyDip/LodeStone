@model StudentSupportRequestsViewModel
@using Lodestone.Domain.Enums
@{
    ViewData["Title"] = "My Support Requests";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/peer-support.css" asp-append-version="true" />
}

<div class="container my-5">
    <div class="row mb-4">
        <div class="col-12">
            <a href="@Url.Action("Index", "Student")" class="btn btn-outline-secondary btn-sm mb-3">← Back to Dashboard</a>
            <h1>My Support Requests</h1>
            <p class="text-muted">Track your peer support requests and conversations with volunteers.</p>
        </div>
    </div>

    @if (TempData["SupportSuccess"] is string success)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @success
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["SupportError"] is string error)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @error
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <div class="col-lg-8">
            @if (Model.Pending.Count == 0 && Model.Active.Count == 0 && Model.History.Count == 0)
            {
                <div class="card">
                    <div class="card-body text-center py-5">
                        <i class="bi bi-inbox" style="font-size: 3rem; color: #ccc;"></i>
                        <h5 class="mt-3">No requests yet</h5>
                        <p class="text-muted">You haven't posted any peer support requests.</p>
                        <a href="@Url.Action("RequestSupport", "StudentSupport")" class="btn btn-primary">
                            <i class="bi bi-plus-circle"></i>
                            Post Your First Request
                        </a>
                    </div>
                </div>
            }
            else
            {
                @if (Model.Pending.Count > 0)
                {
                    <div class="card mb-4">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">
                                <i class="bi bi-hourglass-split"></i>
                                Pending
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="list-group">
                                @foreach (var request in Model.Pending)
                                {
                                    <div class="list-group-item">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div class="flex-grow-1">
                                                <h6 class="mb-1">@request.Title</h6>
                                                <p class="mb-1">
                                                    <span class="badge bg-secondary">@request.Category</span>
                                                </p>
                                                <small class="text-muted">Posted @request.CreatedAtUtc.ToString("MMM d, yyyy")</small>
                                            </div>
                                            <a href="@Url.Action("ViewRequest", "StudentSupport", new { requestId = request.Id })" class="btn btn-sm btn-primary">
                                                View
                                            </a>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                @if (Model.Active.Count > 0)
                {
                    <div class="card mb-4">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">
                                <i class="bi bi-chat-dots"></i>
                                In Progress
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="list-group">
                                @foreach (var request in Model.Active)
                                {
                                    <div class="list-group-item">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div class="flex-grow-1">
                                                <h6 class="mb-1">@request.Title</h6>
                                                <p class="mb-1">
                                                    <span class="badge bg-success">Assigned</span>
                                                    <span class="badge bg-secondary">@request.Category</span>
                                                </p>
                                                <small class="text-muted">Started @request.CreatedAtUtc.ToString("MMM d, yyyy")</small>
                                            </div>
                                            <a href="@Url.Action("ViewRequest", "StudentSupport", new { requestId = request.Id })" class="btn btn-sm btn-primary">
                                                Continue
                                            </a>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                @if (Model.History.Count > 0)
                {
                    <div class="card">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">
                                <i class="bi bi-check-circle"></i>
                                Completed &amp; Escalated
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="list-group">
                                @foreach (var request in Model.History)
                                {
                                    <div class="list-group-item">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div class="flex-grow-1">
                                                <h6 class="mb-1">@request.Title</h6>
                                                <p class="mb-1">
                                                    @{
                                                        var badgeClass = request.Status == SupportRequestStatus.Completed ? "bg-info" : "bg-warning text-dark";
                                                    }
                                                    <span class="badge @badgeClass">@request.Status</span>
                                                    <span class="badge bg-secondary">@request.Category</span>
                                                </p>
                                                <small class="text-muted">@request.CreatedAtUtc.ToString("MMM d, yyyy")</small>
                                            </div>
                                            <a href="@Url.Action("ViewRequest", "StudentSupport", new { requestId = request.Id })" class="btn btn-sm btn-outline-primary">
                                                View
                                            </a>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <div class="col-lg-4">
            @if (Model.Pending.Count > 0 || Model.Active.Count > 0 || Model.History.Count > 0)
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <a href="@Url.Action("RequestSupport", "StudentSupport")" class="btn btn-primary w-100">
                            <i class="bi bi-plus-circle"></i>
                            Post New Request
                        </a>
                    </div>
                </div>
            }

            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Quick Stats</h5>
                </div>
                <div class="card-body">
                    <p class="mb-2">
                        <strong>Total Requests:</strong> @(Model.Pending.Count + Model.Active.Count + Model.History.Count)
                    </p>
                    <p class="mb-2">
                        <strong>Pending:</strong> @Model.Pending.Count
                    </p>
                    <p class="mb-0">
                        <strong>Active:</strong> @Model.Active.Count
                    </p>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Need Help?</h5>
                </div>
                <div class="card-body small">
                    <p><strong>How it works:</strong></p>
                    <ol class="mb-3">
                        <li>Post a request</li>
                        <li>Volunteers review it</li>
                        <li>A volunteer accepts and reaches out</li>
                        <li>You chat and get guidance</li>
                        <li>Request is marked complete</li>
                    </ol>

                    <p><strong>Response time:</strong> Most volunteers respond within 24-48 hours.</p>

                    <p class="mb-0"><strong>In crisis?</strong> Call 988 or visit counseling services immediately.</p>
                </div>
            </div>
        </div>
    </div>
</div>
