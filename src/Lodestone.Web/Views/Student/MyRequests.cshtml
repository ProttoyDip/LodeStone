@model List<SupportRequestDto>
@{
    ViewData["Title"] = "My Support Requests";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <div class="row mb-4">
        <div class="col-12">
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm mb-3">← Back to Dashboard</a>
            <h1>My Support Requests</h1>
            <p class="text-muted">Track your peer support requests and conversations with volunteers.</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <div class="col-lg-8">
            @if (Model.Count == 0)
            {
                <div class="card">
                    <div class="card-body text-center py-5">
                        <i class="bi bi-inbox" style="font-size: 3rem; color: #ccc;"></i>
                        <h5 class="mt-3">No requests yet</h5>
                        <p class="text-muted">You haven't posted any peer support requests.</p>
                        <a href="@Url.Action("RequestSupport")" class="btn btn-primary">
                            <i class="bi bi-plus-circle"></i>
                            Post Your First Request
                        </a>
                    </div>
                </div>
            }
            else
            {
var openRequests = Model.Where(r => r.Status == SupportRequestStatus.Open).ToList();
                    var activeRequests = Model.Where(r => r.Status == SupportRequestStatus.Accepted).ToList();
                    var completedRequests = Model.Where(r => r.Status == SupportRequestStatus.Completed || r.Status == SupportRequestStatus.Declined).ToList();

                @if (openRequests.Count > 0)
                {
                    <div class="card mb-4">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">
                                <i class="bi bi-hourglass-split"></i>
                                Pending
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="list-group">
                                @foreach (var request in openRequests)
                                {
                                    <div class="list-group-item">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div class="flex-grow-1">
                                                <h6 class="mb-1">@request.Title</h6>
                                                <p class="mb-1">
                                                    <span class="badge bg-secondary">@request.Category</span>
                                                </p>
                                                <small class="text-muted">Posted @request.CreatedAtUtc.ToString("MMM d, yyyy")</small>
                                            </div>
                                            <a href="@Url.Action("ViewRequest", new { requestId = request.Id })" class="btn btn-sm btn-primary">
                                                View
                                            </a>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                @if (activeRequests.Count > 0)
                {
                    <div class="card mb-4">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">
                                <i class="bi bi-chat-dots"></i>
                                In Progress
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="list-group">
                                @foreach (var request in activeRequests)
                                {
                                    <div class="list-group-item">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div class="flex-grow-1">
                                                <h6 class="mb-1">@request.Title</h6>
                                                <p class="mb-1">
                                                    <span class="badge bg-success">Assigned</span>
                                                    <span class="badge bg-secondary">@request.Category</span>
                                                </p>
                                                <small class="text-muted">Started @request.CreatedAtUtc.ToString("MMM d, yyyy")</small>
                                            </div>
                                            <a href="@Url.Action("ViewRequest", new { requestId = request.Id })" class="btn btn-sm btn-primary">
                                                Continue
                                            </a>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                @if (completedRequests.Count > 0)
                {
                    <div class="card">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">
                                <i class="bi bi-check-circle"></i>
                                Completed & Declined
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="list-group">
                                @foreach (var request in completedRequests)
                                {
                                    <div class="list-group-item">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div class="flex-grow-1">
                                                <h6 class="mb-1">@request.Title</h6>
                                                <p class="mb-1">
                                                    @{
                                                        var badgeClass = request.Status == SupportRequestStatus.Completed ? "bg-info" : "bg-secondary";
                                                    }
                                                    <span class="badge @badgeClass">@request.Status</span>
                                                    <span class="badge bg-secondary">@request.Category</span>
                                                </p>
                                                <small class="text-muted">@request.CreatedAtUtc.ToString("MMM d, yyyy")</small>
                                            </div>
                                            <a href="@Url.Action("ViewRequest", new { requestId = request.Id })" class="btn btn-sm btn-outline-primary">
                                                View
                                            </a>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <div class="col-lg-4">
            @if (Model.Count > 0)
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <a href="@Url.Action("RequestSupport")" class="btn btn-primary w-100">
                            <i class="bi bi-plus-circle"></i>
                            Post New Request
                        </a>
                    </div>
                </div>
            }

            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Quick Stats</h5>
                </div>
                <div class="card-body">
                    <p class="mb-2">
                        <strong>Total Requests:</strong> @Model.Count
                    </p>
                    <p class="mb-2">
                        <strong>Pending:</strong> @Model.Count(r => r.Status == SupportRequestStatus.Open)
                    </p>
                    <p class="mb-0">
                        <strong>Active:</strong> @Model.Count(r => r.Status == SupportRequestStatus.Accepted)
                    </p>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Need Help?</h5>
                </div>
                <div class="card-body small">
                    <p><strong>How it works:</strong></p>
                    <ol class="mb-3">
                        <li>Post a request</li>
                        <li>Volunteers review it</li>
                        <li>A volunteer accepts and reaches out</li>
                        <li>You chat and get guidance</li>
                        <li>Request is marked complete</li>
                    </ol>

                    <p><strong>Response time:</strong> Most volunteers respond within 24-48 hours.</p>

                    <p class="mb-0"><strong>In crisis?</strong> Call 988 or visit counseling services immediately.</p>
                </div>
            </div>
        </div>
    </div>
</div>
