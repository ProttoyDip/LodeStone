@model Lodestone.Application.DTOs.Forum.ForumModerationQueueDto
@{
    ViewData["Title"] = "Forum Moderation";
}

@section Styles {
    <link rel="stylesheet" href="~/css/forum.css" asp-append-version="true" />
}

<div class="forum-page">
    <section class="forum-subhero">
        <div class="forum-shell">
            <nav class="forum-breadcrumb" aria-label="Breadcrumb">
                <a asp-controller="Forum" asp-action="Index">Forum</a>
                <span aria-hidden="true">/</span>
                <span aria-current="page">Moderation</span>
            </nav>
            <div class="forum-subhero__content">
                <div>
                    <p class="forum-kicker"><span aria-hidden="true"></span>Moderation queue</p>
                    <h1>Review discussions in reading order.</h1>
                    <p>Reported posts come first. Below them are posts nobody reported that went unanswered or stand out from the author's usual posting. The order suggests what to read next; every decision is yours.</p>
                </div>
            </div>
        </div>
    </section>

    <main class="forum-shell forum-content">
        <section aria-labelledby="flagged-posts-title">
            <div class="forum-section-head forum-section-head--compact">
                <div>
                    <p class="forum-section-eyebrow">Review required</p>
                    <h2 id="flagged-posts-title">@Model.Items.Count @(Model.Items.Count == 1 ? "post" : "posts") to read</h2>
                </div>
                <p>@Model.ReportedCount reported · @Model.SurfacedWithoutFlagCount surfaced without a report. Approving keeps a post available; removing takes it out of the public discussion. Either marks it as read.</p>
            </div>

            @if (Model.Items.Count == 0)
            {
                <div class="forum-empty" role="status">
                    <span class="forum-empty__index" aria-hidden="true">00</span>
                    <div>
                        <h3>The moderation queue is clear.</h3>
                        <p>There are no discussions awaiting review.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="forum-post-list" aria-label="Posts awaiting review, most urgent first">
                    @foreach (var item in Model.Items)
                    {
                        var post = item.Post;
                        <article class="forum-post-card">
                            <div class="forum-post-card__meta">
                                @if (item.WasReported)
                                {
                                    <span class="forum-triage-tier forum-triage-tier--reported">Reported</span>
                                }
                                else
                                {
                                    <span class="forum-triage-tier forum-triage-tier--surfaced">Surfaced without a report</span>
                                }
                                <span aria-hidden="true">·</span>
                                <span>Post #@post.Id</span>
                                <span aria-hidden="true">·</span>
                                <span>Status: @post.Status</span>
                                <span aria-hidden="true">·</span>
                                <time datetime="@post.CreatedAtUtc.ToString("O")">@post.CreatedAtUtc.ToString("dd MMM yyyy, HH:mm") UTC</time>
                            </div>
                            <h3><a asp-controller="Forum" asp-action="Post" asp-route-id="@post.Id">@post.Title</a></h3>
                            <p class="forum-post-card__excerpt">@post.Body</p>
                            @if (item.Reasons.Count > 0)
                            {
                                <ul class="forum-triage-reasons" aria-label="Why this post is in the queue">
                                    @foreach (var reason in item.Reasons)
                                    {
                                        <li>@reason</li>
                                    }
                                </ul>
                            }

                            <form class="forum-form__footer" action="/Forum/Review" method="post" aria-label="Moderation decision for post @post.Id">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="postId" value="@post.Id" />
                                <p>Read the post before deciding. Nothing here is a judgement about the author.</p>
                                <div>
                                    <button class="ls-btn ls-btn--ghost ls-btn--sm" type="submit" name="publish" value="true">@(item.WasReported ? "Approve post" : "Mark as read")</button>
                                    <button class="ls-btn ls-btn--clay ls-btn--sm" type="submit" name="publish" value="false">Remove post</button>
                                </div>
                            </form>
                        </article>
                    }
                </div>
            }
        </section>
    </main>
</div>
