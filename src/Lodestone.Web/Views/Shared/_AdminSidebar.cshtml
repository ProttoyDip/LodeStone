@using Lodestone.Application.DTOs.Admin

@{
    var active = ViewData["AdminActiveSection"]?.ToString() ?? AdminSectionType.Dashboard.ToString();
}

<div class="ls-admin-side__header">
    <a class="ls-admin-side__brand" asp-controller="Admin" asp-action="Index" aria-label="Lodestone admin home">
        <span>Lodestone<span class="ls-admin-side__brand-dot" aria-hidden="true">.</span></span>
    </a>
    <button class="ls-admin-side__close"
            type="button"
            data-admin-drawer-close
            aria-label="Close navigation">
        <i class="bi bi-x-lg" aria-hidden="true"></i>
    </button>
</div>

<nav class="ls-admin-side" aria-label="Admin sections">
    <div class="ls-admin-side__group">
        <p class="ls-admin-side__group-label">Overview</p>
        <a class="ls-admin-link @(active == AdminSectionType.Dashboard.ToString() ? "is-active" : string.Empty)"
           asp-controller="Admin"
           asp-action="Index"
           aria-current="@(active == AdminSectionType.Dashboard.ToString() ? "page" : null)">
            <i class="bi bi-grid-1x2" aria-hidden="true"></i>
            <span>Dashboard</span>
        </a>
    </div>

    <div class="ls-admin-side__group">
        <p class="ls-admin-side__group-label">Care Operations</p>
        <a class="ls-admin-link"
           asp-controller="Counselor"
           asp-action="Queue">
            <i class="bi bi-life-preserver" aria-hidden="true"></i>
            <span>Support Queue</span>
        </a>
        <a class="ls-admin-link @(active == AdminSectionType.RiskMonitoring.ToString() ? "is-active" : string.Empty)"
           asp-controller="Admin"
           asp-action="RiskMonitoring"
           aria-current="@(active == AdminSectionType.RiskMonitoring.ToString() ? "page" : null)">
            <i class="bi bi-cpu" aria-hidden="true"></i>
            <span>Risk Operations</span>
        </a>
        <a class="ls-admin-link @(active == AdminSectionType.CounselorBookings.ToString() ? "is-active" : string.Empty)"
           asp-controller="Admin"
           asp-action="CounselorBookings"
           aria-current="@(active == AdminSectionType.CounselorBookings.ToString() ? "page" : null)">
            <i class="bi bi-calendar2-check" aria-hidden="true"></i>
            <span>Bookings</span>
        </a>
        <a class="ls-admin-link @(active == AdminSectionType.Counselors.ToString() ? "is-active" : string.Empty)"
           asp-controller="Admin"
           asp-action="Counselors"
           aria-current="@(active == AdminSectionType.Counselors.ToString() ? "page" : null)">
            <i class="bi bi-person-badge" aria-hidden="true"></i>
            <span>Counselors</span>
        </a>
    </div>

    <div class="ls-admin-side__group">
        <p class="ls-admin-side__group-label">Community</p>
        <a class="ls-admin-link @(active == AdminSectionType.ForumModeration.ToString() ? "is-active" : string.Empty)"
           asp-controller="Admin"
           asp-action="ForumModeration"
           aria-current="@(active == AdminSectionType.ForumModeration.ToString() ? "page" : null)">
            <i class="bi bi-chat-square-dots" aria-hidden="true"></i>
            <span>Forum Moderation</span>
        </a>
        <a class="ls-admin-link @(active == AdminSectionType.Volunteers.ToString() ? "is-active" : string.Empty)"
           asp-controller="Admin"
           asp-action="Volunteers"
           aria-current="@(active == AdminSectionType.Volunteers.ToString() ? "page" : null)">
            <i class="bi bi-people" aria-hidden="true"></i>
            <span>Volunteers</span>
        </a>
    </div>

    <div class="ls-admin-side__group">
        <p class="ls-admin-side__group-label">People &amp; Access</p>
        <a class="ls-admin-link @(active == AdminSectionType.Students.ToString() ? "is-active" : string.Empty)"
           asp-controller="Admin"
           asp-action="Students"
           aria-current="@(active == AdminSectionType.Students.ToString() ? "page" : null)">
            <i class="bi bi-mortarboard" aria-hidden="true"></i>
            <span>Students</span>
        </a>
        <a class="ls-admin-link @(active == AdminSectionType.Users.ToString() ? "is-active" : string.Empty)"
           asp-controller="Admin"
           asp-action="Users"
           aria-current="@(active == AdminSectionType.Users.ToString() ? "page" : null)">
            <i class="bi bi-person-lock" aria-hidden="true"></i>
            <span>Users</span>
        </a>
    </div>

    <div class="ls-admin-side__group">
        <p class="ls-admin-side__group-label">System</p>
        <a class="ls-admin-link @(active == AdminSectionType.Notifications.ToString() ? "is-active" : string.Empty)"
           asp-controller="Admin"
           asp-action="Notifications"
           aria-current="@(active == AdminSectionType.Notifications.ToString() ? "page" : null)">
            <i class="bi bi-bell" aria-hidden="true"></i>
            <span>Notifications</span>
        </a>
        <a class="ls-admin-link @(active == AdminSectionType.AuditLogs.ToString() ? "is-active" : string.Empty)"
           asp-controller="Admin"
           asp-action="AuditLogs"
           aria-current="@(active == AdminSectionType.AuditLogs.ToString() ? "page" : null)">
            <i class="bi bi-journal-check" aria-hidden="true"></i>
            <span>Audit Logs</span>
        </a>
    </div>
</nav>

<div class="ls-admin-side__footer">
    <p>Care operations console</p>
    <span>Private workspace</span>
</div>
